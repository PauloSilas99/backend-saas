generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLATFORM_ADMIN
  GERENTE
  GESTOR
  OPERACIONAL
  LEITOR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INACTIVE
}

enum ImportStatus {
  PENDING
  PROCESSING
  READY_FOR_MAPPING
  READY_FOR_PREVIEW
  PREVIEW
  PROCESSING_COMMIT
  COMPLETED
  FAILED
  PARTIAL
}

enum ImportRowStatus {
  OK
  WARNING
  ERROR
}

enum ActionStatus {
  PENDING
  IN_PROGRESS
  WAITING_APPROVAL
  COMPLETED
  REJECTED
  DELAYED
  CANCELED
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ColumnFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  USER
  UNIT
  CURRENCY
  PERCENTAGE
}

enum ColumnHistoryAction {
  CREATED
  UPDATED
  DELETED
  RESTORED
}

/** Papel nativo da coluna no workbook — alimenta prazo, ACL e calendário. */
enum ColumnSemanticRole {
  NONE
  DUE_DATE
  ASSIGNEE
  TITLE
  STATUS
  PRIORITY
}

enum RiskStatus {
  OPEN
  MITIGATING
  CLOSED
  ACCEPTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ControlStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELED
}

enum CalendarActivityStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELED
}

enum CalendarOverrideType {
  BLOCKED
  NOTE
  HOLIDAY
  CUSTOM
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String
  /** Contato WhatsApp informado no cadastro (somente dígitos / E.164 preferível). */
  whatsapp        String?   @map("whatsapp")
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  tokenVersion    Int       @default(0) @map("token_version")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships      Membership[]
  refreshTokens    RefreshToken[]
  authTokens       AuthToken[]
  actionPlans      ActionPlan[]       @relation("ActionPlanOwner")
  assignedRows     ActionPlanRow[]    @relation("AssignedRows")
  auditLogs        AuditLog[]
  createdImports   Import[]           @relation("ImportCreator")
  actionHistories  ActionHistory[]    @relation("ActionHistoryActor")
  columnHistories  ActionColumnHistory[] @relation("ColumnHistoryActor")
  ownedRisks       Risk[]             @relation("RiskOwner")
  deletedColumns   ActionColumn[]     @relation("ColumnDeletedBy")
  actionControls   ActionControl[]    @relation("ControlResponsible")
  calendarActivitiesCreated CalendarActivity[] @relation("CalendarActivityCreator")
  calendarActivitiesAssigned CalendarActivity[] @relation("CalendarActivityAssignee")
  calendarOverridesCreated CalendarOverride[] @relation("CalendarOverrideCreator")
  calendarActionOverlays CalendarActionOverlay[] @relation("CalendarActionOverlayOwner")

  @@map("users")
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  type      AuthTokenType
  tokenHash String        @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, type])
  @@map("auth_tokens")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  document  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships  Membership[]
  units        Unit[]
  actionPlans  ActionPlan[]
  imports      Import[]
  subscription Subscription?
  payments     Payment[]
  auditLogs    AuditLog[]
  columns      ActionColumn[]
  risks        Risk[]
  calendarActivities CalendarActivity[]
  calendarOverrides  CalendarOverride[]
  calendarActionOverlays CalendarActionOverlay[]

  @@map("tenants")
}

model Unit {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  code      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionPlans ActionPlan[]
  rows        ActionPlanRow[]

  @@unique([tenantId, name])
  @@map("units")
}

model Membership {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  role      Role
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, role, isActive])
  @@map("memberships")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tenantId  String?   @map("tenant_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Plan {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  description   String?
  priceCents    Int      @map("price_cents")
  currency      String   @default("BRL")
  interval      String   @default("month")
  features      Json?
  isActive      Boolean  @default(true) @map("is_active")
  externalId    String?  @map("external_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique @map("tenant_id")
  planId               String             @map("plan_id")
  status               SubscriptionStatus @default(INACTIVE)
  externalId           String?            @map("external_id")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  subscriptionId String?       @map("subscription_id")
  amountCents    Int           @map("amount_cents")
  currency       String        @default("BRL")
  status         PaymentStatus @default(PENDING)
  externalId     String?       @map("external_id")
  paidAt         DateTime?     @map("paid_at")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

model ActionPlan {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  unitId      String?  @map("unit_id")
  ownerId     String   @map("owner_id")
  title       String
  description String?
  year        Int?
  month       Int?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit    Unit?           @relation(fields: [unitId], references: [id])
  owner   User            @relation("ActionPlanOwner", fields: [ownerId], references: [id])
  rows    ActionPlanRow[]
  columns ActionColumn[]
  imports Import[]

  @@map("action_plans")
}

model ActionPlanRow {
  id              String         @id @default(uuid())
  actionPlanId    String         @map("action_plan_id")
  unitId          String?        @map("unit_id")
  responsibleId   String?        @map("responsible_id")
  externalKey     String?        @map("external_key")
  title           String
  description     String?
  status          ActionStatus   @default(PENDING)
  priority        ActionPriority @default(MEDIUM)
  dueDate         DateTime?      @map("due_date")
  completedAt     DateTime?      @map("completed_at")
  responsibleName String?        @map("responsible_name")
  unitName        String?        @map("unit_name")
  metadata        Json?
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  actionPlan  ActionPlan      @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  unit        Unit?           @relation(fields: [unitId], references: [id])
  responsible User?           @relation("AssignedRows", fields: [responsibleId], references: [id])
  histories   ActionHistory[]
  fieldValues ActionFieldValue[]
  risks       Risk[]
  calendarOverlays CalendarActionOverlay[]

  @@unique([actionPlanId, externalKey])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("action_plan_rows")
}

model ActionHistory {
  id            String        @id @default(uuid())
  actionRowId   String        @map("action_row_id")
  actorId       String?       @map("actor_id")
  fromStatus    ActionStatus? @map("from_status")
  toStatus      ActionStatus? @map("to_status")
  comment       String?
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at")

  actionRow ActionPlanRow @relation(fields: [actionRowId], references: [id], onDelete: Cascade)
  actor     User?         @relation("ActionHistoryActor", fields: [actorId], references: [id])

  @@index([actionRowId, createdAt])
  @@map("action_histories")
}

model ActionColumn {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  actionPlanId String             @map("action_plan_id")
  name         String
  label        String
  fieldType    ColumnFieldType    @map("field_type")
  semanticRole ColumnSemanticRole @default(NONE) @map("semantic_role")
  required     Boolean            @default(false)
  options      Json?
  sortOrder    Int                @default(0) @map("sort_order")
  isActive     Boolean            @default(true) @map("is_active")
  deletedAt    DateTime?          @map("deleted_at")
  deletedById  String?            @map("deleted_by_id")
  deleteReason String?            @map("delete_reason")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionPlan ActionPlan            @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  deletedBy  User?                 @relation("ColumnDeletedBy", fields: [deletedById], references: [id])
  values     ActionFieldValue[]
  histories  ActionColumnHistory[]

  @@unique([actionPlanId, name])
  @@index([tenantId, isActive, deletedAt])
  @@index([actionPlanId, isActive, deletedAt])
  @@map("action_columns")
}

model ActionColumnHistory {
  id        String              @id @default(uuid())
  columnId  String              @map("column_id")
  actorId   String?             @map("actor_id")
  action    ColumnHistoryAction
  snapshot  Json
  createdAt DateTime            @default(now()) @map("created_at")

  column ActionColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  actor  User?        @relation("ColumnHistoryActor", fields: [actorId], references: [id])

  @@index([columnId, createdAt])
  @@map("action_column_histories")
}

model ActionFieldValue {
  id          String   @id @default(uuid())
  actionRowId String   @map("action_row_id")
  columnId    String   @map("column_id")
  value       Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  actionRow ActionPlanRow @relation(fields: [actionRowId], references: [id], onDelete: Cascade)
  column    ActionColumn  @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@unique([actionRowId, columnId])
  @@index([columnId])
  @@map("action_field_values")
}

model Risk {
  id              String     @id @default(uuid())
  tenantId        String     @map("tenant_id")
  actionRowId     String?    @map("action_row_id")
  ownerId         String?    @map("owner_id")
  title           String
  description     String?
  probability     RiskLevel  @default(MEDIUM)
  impact          RiskLevel  @default(MEDIUM)
  severity        RiskLevel  @default(MEDIUM)
  status          RiskStatus @default(OPEN)
  mitigationPlan  String?    @map("mitigation_plan")
  dueDate         DateTime?  @map("due_date")
  deletedAt       DateTime?  @map("deleted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionRow ActionPlanRow?  @relation(fields: [actionRowId], references: [id])
  owner     User?           @relation("RiskOwner", fields: [ownerId], references: [id])
  controls  ActionControl[]

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("risks")
}

model ActionControl {
  id              String        @id @default(uuid())
  riskId          String        @map("risk_id")
  title           String
  description     String?
  status          ControlStatus @default(PENDING)
  responsibleId   String?       @map("responsible_id")
  dueDate         DateTime?     @map("due_date")
  completedAt     DateTime?     @map("completed_at")
  evidence        String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  risk          Risk  @relation(fields: [riskId], references: [id], onDelete: Cascade)
  responsible   User? @relation("ControlResponsible", fields: [responsibleId], references: [id])

  @@index([riskId, status])
  @@map("action_controls")
}

model Import {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  createdById     String       @map("created_by_id")
  actionPlanId    String?      @map("action_plan_id")
  filename        String
  originalName    String       @map("original_name")
  mimeType        String       @map("mime_type")
  filePath        String       @default("") @map("file_path")
  status          ImportStatus @default(PENDING)
  totalRows       Int          @default(0) @map("total_rows")
  successRows     Int          @default(0) @map("success_rows")
  errorRows       Int          @default(0) @map("error_rows")
  warningRows     Int          @default(0) @map("warning_rows")
  headers         Json?
  columnMapping   Json?        @map("column_mapping")
  previewData     Json?        @map("preview_data")
  errorReport     Json?        @map("error_report")
  statusMessage   String?      @map("status_message")
  idempotencyKey  String?      @unique @map("idempotency_key")
  confirmedAt     DateTime?    @map("confirmed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User        @relation("ImportCreator", fields: [createdById], references: [id])
  actionPlan ActionPlan? @relation(fields: [actionPlanId], references: [id])
  rows       ImportRow[]

  @@index([tenantId, createdAt])
  @@map("imports")
}

model ImportRow {
  id         String          @id @default(uuid())
  importId   String          @map("import_id")
  lineNumber Int             @map("line_number")
  rawData    Json            @map("raw_data")
  mappedData Json?           @map("mapped_data")
  status     ImportRowStatus @default(OK)
  messages   Json?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  import Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, lineNumber])
  @@index([importId, status])
  @@map("import_rows")
}

/// Agenda / pendências independentes do fluxo de action-plans / planilha.
model CalendarActivity {
  id           String                 @id @default(uuid())
  tenantId     String                 @map("tenant_id")
  createdById  String                 @map("created_by_id")
  assigneeId   String?                @map("assignee_id")
  title        String
  description  String?
  startsAt     DateTime               @map("starts_at")
  endsAt       DateTime?              @map("ends_at")
  allDay       Boolean                @default(false) @map("all_day")
  status       CalendarActivityStatus @default(PENDING)
  location     String?
  color        String?
  metadata     Json?
  deletedAt    DateTime?              @map("deleted_at")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("CalendarActivityCreator", fields: [createdById], references: [id])
  assignee  User?  @relation("CalendarActivityAssignee", fields: [assigneeId], references: [id])

  @@index([tenantId, startsAt])
  @@index([tenantId, status])
  @@index([assigneeId, startsAt])
  @@map("calendar_activities")
}

/// Sobrescritas de dia (bloqueio, feriado, nota) — independentes das ações.
model CalendarOverride {
  id          String               @id @default(uuid())
  tenantId    String               @map("tenant_id")
  createdById String               @map("created_by_id")
  date        DateTime             @db.Date
  type        CalendarOverrideType @default(NOTE)
  title       String?
  note        String?
  metadata    Json?
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("CalendarOverrideCreator", fields: [createdById], references: [id])

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("calendar_overrides")
}

/// Overlay pessoal sobre uma ação da base (planilha).
/// NÃO altera ActionPlanRow.dueDate — só a visão do usuário no calendário.
model CalendarActionOverlay {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  userId          String    @map("user_id")
  actionRowId     String    @map("action_row_id")
  displayStartsAt DateTime? @map("display_starts_at")
  displayEndsAt   DateTime? @map("display_ends_at")
  hidden          Boolean   @default(false)
  note            String?
  color           String?
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User          @relation("CalendarActionOverlayOwner", fields: [userId], references: [id], onDelete: Cascade)
  actionRow ActionPlanRow @relation(fields: [actionRowId], references: [id], onDelete: Cascade)

  @@unique([userId, actionRowId])
  @@index([tenantId, userId])
  @@index([actionRowId])
  @@map("calendar_action_overlays")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?  @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  metadata   Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
